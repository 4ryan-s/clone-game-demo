# Copy to .env and fill in. Docker Compose reads this file.
SARVAM_API_KEY=

# Host port for the quiz. Default 8000.
DEMO_PORT=8000

# cu128 for an NVIDIA server. cpu for a machine with no GPU (much slower).
TORCH_VARIANT=cu128

# Public name for the optional HTTPS proxy (docker compose -f docker-compose.yml -f docker-compose.https.yml).
# Browsers only allow the microphone on localhost or https.
DEMO_DOMAIN=demo.example.com

# --- Qwen3-TTS workers on one 16 GB GPU. Pick ONE preset. Default (nothing set) = one worker.
# One worker (safest for memory): leave these unset, or:
#   QWEN_MAX_BATCH=4
#   QWEN_GPU_MEM_FRACTION=0.6
# Two workers (each loads its own copy of the model; needs the GPU memory, watch nvidia-smi):
#   COMPOSE_PROFILES=two-workers
#   QWEN_URLS=http://qwen:8766,http://qwen2:8766
#   QWEN_MAX_BATCH=3
#   QWEN_GPU_MEM_FRACTION=0.35


# --- Two Qwen workers on the 16 GB T4 (needs the api's clone check on the CPU to free 2.2 GB of GPU memory). Measure with tests/load_test.py first.
#   COMPOSE_PROFILES=two-workers
#   QWEN_URLS=http://qwen:8766,http://qwen2:8766
#   SPECTRA_DEVICE=cpu
#   QWEN_MAX_BATCH=2
#   QWEN_GPU_MEM_FRACTION=0.42
# --- Runaway clips make the whole batch run to the token limit. Experiment: cap each clip relative to the recording's length (0 = off).
#   QWEN_BUDGET_REF_FACTOR=1.3
