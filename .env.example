# Copy to .env and fill in. Docker Compose reads this file.
SARVAM_API_KEY=

# Host port for the quiz. Default 8000.
DEMO_PORT=8000

# cu128 for an NVIDIA server. cpu for a machine with no GPU (much slower).
TORCH_VARIANT=cu128

# Public name for the optional HTTPS proxy (docker compose -f docker-compose.yml -f docker-compose.https.yml).
# Browsers only allow the microphone on localhost or https.
DEMO_DOMAIN=demo.example.com
